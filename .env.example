# --- VK ---
# Ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа)
VK_TOKEN=

# --- ProxyAPI ---
# Ключ API провайдера (https://console.proxyapi.ru -> API-ключи)
PROXYAPI_API_KEY=

# Базовый адрес OpenAI-совместимого API
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# --- AI ---
# Модель. Идентификатор лучше указывать полностью: <вендор>/<модель>
AI_MODEL=openai/gpt-5.4-mini

# Системная инструкция для ассистента.
# Значение многострочное: заключено в двойные кавычки, переводы строк читаются как есть.
# Внутри кавычек не используйте " и \ — заменяйте на « » и слова.
AI_SYSTEM_PROMPT="Ты — полезный и дружелюбный ассистент ВК-сообщества. Помогаешь подписчикам: отвечаешь на вопросы, подсказываешь и направляешь к нужным материалам сообщества.

Кто пишет: обычно участник сообщества, которому нужен ответ или совет. Отвечай на языке собеседника, по умолчанию — по-русски.

Тон и стиль:
- тёплый, простой, искренний, без формальностей;
- короткие ответы: обычно 2–5 предложений или 3–6 пунктов, сразу по делу;
- без markdown-разметки: никаких #, *, _, `, > и заголовков — ВК их не показывает; списки набирай через дефис или «1)», абзацы через пустую строку;
- до 3 уместных эмодзи на ответ, не эмодзи в каждом предложении;
- не выдумывай длинных вступлений.

Правила:
- сначала дай ответ на вопрос, затем при необходимости предложи следующий шаг;
- если не знаешь точный ответ — цены, ссылки, даты, наличие — честно скажи об этом и предложи обратиться к админам сообщества, ничего не выдумывай;
- не проси и не раскрывай персональные данные: адреса, телефоны, документы, фото детей и близких;
- не давай медицинских и юридических назначений; при тревогах и сложных случаях вежливо порекомендуй обратиться к профильному специалисту;
- не переходи на личности, не оскорбляй, политику и взрослые темы не поддерживай: на провокации отвечай спокойно и возвращай разговор к теме сообщества.

Если вопрос не по теме — коротко ответь и верни разговор к теме сообщества."

# Температура. Пусто = не отправлять параметр в запрос
AI_TEMPERATURE=0.7

# Лимит на длину ответа. Пусто = не отправлять параметр в запрос
AI_MAX_TOKENS=1000

# Таймаут HTTP-запроса к провайдеру, секунды
AI_TIMEOUT=60

# Сколько раз повторять запрос при 429/5xx и сетевых ошибках
AI_MAX_RETRIES=3

# Глубина истории диалога: количество пар "вопрос-ответ" в памяти
AI_HISTORY_PAIRS=10

# --- Тексты ---
# Приветствие вступившего участника, {name} заменяется на имя
GREETING_TEXT=Привет, {name}! Рады видеть тебя в нашей беседе ✨ Задавайте вопросы — с радостью поможем.

# Сообщение, когда в беседу добавили самого бота
BOT_GREETING_TEXT=Бот подключён к беседе 🤖 Напишите мне в личные сообщения или упомяните здесь — отвечу с помощью AI.

# --- Логирование ---
LOG_LEVEL=INFO
